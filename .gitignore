# Godot 4+ specific ignores
.godot/
/android/


# GameCreator local developer credentials
/gamecreator/personal/

# Local GameCreator connection, credentials, collaboration snapshots and history.
/gamecreator/
/.gamecreator-sync/

# Planning transaction inputs and machine-specific workflow helpers.
/planning/*.json
/planning/*.cjs

# Retain final evidence; omit local operation payloads and receipts.
/reports/v0.1/*.json
!/reports/v0.1/version-manifest.json
!/reports/v0.1/movement-results.json
!/reports/v0.1/flow-results.json
!/reports/v0.1/independent_runtime.json
!/reports/v0.1/realtime-clock.json
/reports/v0.1/*.cjs
!/reports/v0.1/generate-manifest.cjs
/reports/v0.1/workflow/

# v0.2 workflow payloads stay local; publish only verification results.
/reports/v0.2/*.json
!/reports/v0.2/*-results.json
!/reports/v0.2/version-manifest.json
!/reports/v0.2/realtime-clock.json
!/reports/v0.2/independent_runtime.json
/reports/v0.2/*.cjs
!/reports/v0.2/generate-manifest.cjs
/reports/v0.2/workflow/
/reports/**/workflow/
/reports/v0.2/independent-checks/start.json
/reports/v0.2/independent-checks/delivery*.json

# Godot regenerates import sidecars and editor caches.
*.import
*.log
*.tmp
.DS_Store
Thumbs.db
.env
.env.*
*.pem
*.key
