# Godot 4+ specific ignores
.godot/
/android/


# GameCreator local developer credentials
/gamecreator/personal/

# Local GameCreator connection, credentials, collaboration snapshots and history.
/gamecreator/
/.gamecreator-sync/

# Planning transaction inputs and machine-specific workflow helpers.
/planning/*.json
/planning/*.cjs

# Retain final evidence; omit local operation payloads and receipts.
/reports/v0.1/*.json
!/reports/v0.1/version-manifest.json
!/reports/v0.1/movement-results.json
!/reports/v0.1/flow-results.json
!/reports/v0.1/independent_runtime.json
!/reports/v0.1/realtime-clock.json
/reports/v0.1/*.cjs
!/reports/v0.1/generate-manifest.cjs
/reports/v0.1/workflow/

# v0.2 workflow payloads stay local; publish only verification results.
/reports/v0.2/*.json
!/reports/v0.2/*-results.json
!/reports/v0.2/version-manifest.json
!/reports/v0.2/realtime-clock.json
!/reports/v0.2/independent_runtime.json
/reports/v0.2/*.cjs
!/reports/v0.2/generate-manifest.cjs
/reports/v0.2/workflow/
/reports/**/workflow/
/reports/v0.2.1/art/workflow/
/reports/v0.2.1/frames/
/reports/v0.2.1/art/frames/
/reports/v0.2.1/art/start.json
/reports/v0.2.1/art/delivery*.json
/reports/v0.2.1/art/review*.json
/reports/v0.3/*.json
!/reports/v0.3/*-results.json
!/reports/v0.3/version-manifest.json
/reports/v0.3/*.cjs
!/reports/v0.3/generate-manifest.cjs
/reports/v0.3/art/frames/
/reports/v0.3/art/station/frames/
/reports/v0.3/art/start*.json
/reports/v0.3/art/delivery*.json
/reports/v0.3/art/review*.json
/reports/v0.3/independent-checks/start*.json
/reports/v0.3/independent-checks/delivery*.json
/reports/v0.3/independent-checks/review*.json
/reports/v0.3/frames/
/reports/v0.4/*.json
!/reports/v0.4/*-results.json
!/reports/v0.4/version-manifest.json
/reports/v0.4/*.cjs
!/reports/v0.4/generate-manifest.cjs
/reports/v0.4/art/workflow.cjs
/reports/v0.4/art/start*.json
/reports/v0.4/art/*-start-*.json
/reports/v0.4/art/*-submit-*.json
/reports/v0.4/art/*-review-*.json
/reports/v0.4/art/fixture-record.json
/reports/v0.4/art/c-frames/
/reports/v0.4/art/f-frames/
/reports/v0.4/independent-checks/*-start*.json
/reports/v0.4/independent-checks/*-submit*.json
/reports/v0.4/independent-checks/*-review*.json
/reports/v0.4/independent-checks/start*.json
/reports/v0.4/independent-checks/submit*.json
/reports/v0.4/independent-checks/review*.json
/reports/v0.4/independent-checks/workflow.cjs
/reports/v0.4/independent-checks/isolated-record*.json
/reports/v0.4/independent-checks/frames/
/reports/v0.4/frames/
/reports/v0.2.1/*-request.json
/reports/v0.2.1/*-receipt.json
/reports/v0.2/independent-checks/start.json
/reports/v0.2/independent-checks/delivery*.json

# Godot regenerates import sidecars and editor caches.
*.import
*.log
*.tmp
/resources/generation/*.bak
/reports/v0.4.1/workflow/
/reports/v0.4.1/art/*-request.json
/reports/v0.4.1/art/*-receipt.json
/reports/v0.4.1/independent-checks/*-request.json
/reports/v0.4.1/independent-checks/*-receipt.json
/reports/v0.4.1/independent-checks/start*.json
/reports/v0.4.1/independent-checks/submit*.json
/reports/v0.4.1/independent-checks/review*.json
/reports/v0.4.1/independent-checks/append*.json
/reports/v0.4.1/independent-checks/workflow.cjs
/reports/v0.4.1/independent-checks/*-default*.json
/reports/v0.4.1/independent-checks/*-profile*.json
/reports/v0.4.1/art/start*.json
/reports/v0.4.1/art/submit*.json
/reports/v0.4.1/art/review*.json
/reports/v0.4.1/**/isolated-*
/reports/v0.4.1/**/*.bak
.DS_Store
Thumbs.db
.env
.env.*
*.pem
*.key
